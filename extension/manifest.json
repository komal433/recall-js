{
  "manifest_version": 3,
  "name": "Recall Quick Save",
  "version": "1.0.0",
  "description": "Save learning resources quickly from any webpage.",
  "permissions": ["activeTab", "tabs"],
  "host_permissions": [
    "http://localhost:5000/*",
    "http://127.0.0.1:5000/*"
  ],
  "action": {
    "default_title": "Recall Quick Save",
    "default_popup": "popup.html"
  }
}